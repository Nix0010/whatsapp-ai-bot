# Variables de entorno - WhatsApp AI Bot
# Copia este archivo como .env y completa los valores

# === GROQ AI ===
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# === BOT CONFIG ===
BOT_NAME=Asistente Virtual
SESSION_NAME=mi-negocio

# === NEGOCIO ===
# Estos datos los usará la IA para responder preguntas
BUSINESS_NAME=Mi Negocio
BUSINESS_TYPE=negocio general
BUSINESS_PHONE=+57 300 000 0000
BUSINESS_EMAIL=contacto@minegocio.com
BUSINESS_ADDRESS=Ciudad, País
BUSINESS_HOURS=Lunes a Viernes 8am-6pm, Sábados 9am-2pm
BUSINESS_SERVICES=Consulta los servicios disponibles con nuestro equipo
